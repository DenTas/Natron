+// AVCodec::pix_fmts was deprecated in FFmpeg 7.1 (libavcodec 61.13.100) and removed in FFmpeg 8.
+// Returns the list of pixel formats supported by the codec, terminated by AV_PIX_FMT_NONE,
+// or nullptr if unknown.
+static const AVPixelFormat*
+codecPixelFormats(const AVCodec* codec)
+{
+#if LIBAVCODEC_VERSION_INT >= AV_VERSION_INT(61, 13, 100)
+    const void* formats = nullptr;
+    int nbFormats = 0;
+    if (avcodec_get_supported_config(nullptr, codec, AV_CODEC_CONFIG_PIX_FORMAT, 0, &formats, &nbFormats) < 0) {
+        return nullptr;
+    }
+    return static_cast<const AVPixelFormat*>(formats);
+#else
+    return codec->pix_fmts;
+#endif
+}
